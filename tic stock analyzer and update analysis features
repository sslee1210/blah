[32m+[m[32mdef _is_process_alive(pid: int) -> bool:[m
[32m+[m[32m    if os.name != "nt" or pid <= 0:[m
[32m+[m[32m        return False[m
[32m+[m[32m    process = ctypes.windll.kernel32.OpenProcess(0x1000, False, pid)[m
[32m+[m[32m    if not process:[m
[32m+[m[32m        return False[m
[32m+[m[32m    ctypes.windll.kernel32.CloseHandle(process)[m
