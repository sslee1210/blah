[32m+[m[32m@contextmanager[m
[32m+[m[32mdef single_instance() -> Iterator[None]:[m
[32m+[m[32m    RUNTIME_DIR.mkdir(parents=True, exist_ok=True)[m
[32m+[m[32m    if LOCK_PATH.exists():[m
[32m+[m[32m        try:[m
[32m+[m[32m            pid = int(LOCK_PATH.read_text(encoding="ascii").strip())[m
[32m+[m[32m        except (OSError, ValueError):[m
[32m+[m[32m            pid = 0[m
[32m+[m[32m        if _is_process_alive(pid):[m
[32m+[m[32m            raise RuntimeError("다른 키움 주식 분석이 이미 실행 중입니다. 기존 작업이 끝난 뒤 다시 실행해 주세요.")[m
[32m+[m[32m        LOCK_PATH.unlink(missing_ok=True)[m
[32m+[m[32m    handle = os.open(LOCK_PATH, os.O_CREAT | os.O_EXCL | os.O_WRONLY)[m
[32m+[m[32m    try:[m
[32m+[m[32m        os.write(handle, str(os.getpid()).encode("ascii"))[m
[32m+[m[32m        os.close(handle)[m
[32m+[m[32m        yield[m
[32m+[m[32m    finally:[m
[32m+[m[32m        try:[m
[32m+[m[32m            os.close(handle)[m
[32m+[m[32m        except OSError:[m
[32m+[m[32m            pass[m
[32m+[m[32m        LOCK_PATH.unlink(missing_ok=True)[m
