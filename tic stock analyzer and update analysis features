[32m+[m[32m    @staticmethod[m
[32m+[m[32m    def _extract_report_path(line: str) -> Path | None:[m
[32m+[m[32m        for prefix in ("HTML 보고서:", "보고서:"):[m
[32m+[m[32m            if line.startswith(prefix):[m
[32m+[m[32m                path_text = line.split(":", 1)[1].strip()[m
[32m+[m[32m                if not path_text:[m
[32m+[m[32m                    return None[m
[32m+[m[32m                candidate = Path(path_text)[m
[32m+[m[32m                if not candidate.is_absolute():[m
[32m+[m[32m                    candidate = ROOT / candidate[m
[32m+[m[32m                candidate = candidate.resolve()[m
[32m+[m[32m                if ([m
[32m+[m[32m                    candidate.is_relative_to((ROOT / "reports").resolve())[m
[32m+[m[32m                    and candidate.suffix.lower() in {".html", ".md"}[m
[32m+[m[32m                    and candidate.is_file()[m
[32m+[m[32m                ):[m
