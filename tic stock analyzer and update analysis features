[32m+[m[32m    def _run_process(self, analyzer: Path, command: str, market_name: str) -> None:[m
[32m+[m[32m        env = os.environ.copy()[m
[32m+[m[32m        env["PYTHONIOENCODING"] = "utf-8"[m
[32m+[m[32m        env["PYTHONUTF8"] = "1"[m
[32m+[m[32m        try:[m
[32m+[m[32m            with self._process_lock:[m
[32m+[m[32m                # Closing/cancelling must also cover the interval before Popen[m
[32m+[m[32m                # has returned and registered its child process.[m
[32m+[m[32m                if self._cancelled:[m
[32m+[m[32m                    self._events.put(("done", (market_name, 1)))[m
[32m+[m[32m                    return[m
[32m+[m[32m                process = subprocess.Popen([m
[32m+[m[32m                    [sys.executable, "-u", str(analyzer), "--once", command],[m
[32m+[m[32m                    cwd=str(ROOT),[m
[32m+[m[32m                    stdin=subprocess.DEVNULL,[m
[32m+[m[32m                    stdout=subprocess.PIPE,[m
[32m+[m[32m                    stderr=subprocess.STDOUT,[m
[32m+[m[32m                    text=True,[m
[32m+[m[32m                    encoding="utf-8",[m
[32m+[m[32m                    errors="replace",[m
[32m+[m[32m                    env=env,[m
[32m+[m[32m                )[m
[32m+[m[32m                self._process = process[m
[32m+[m[32m            assert process.stdout is not None[m
[32m+[m[32m            for line in process.stdout:[m
[32m+[m[32m                clean = line.rstrip("\r\n")[m
[32m+[m[32m                self._events.put(("line", clean))[m
[32m+[m[32m                report = self._extract_report_path(clean)[m
[32m+[m[32m                if report is not None:[m
[32m+[m[32m                    self._events.put(("report", report))[m
[32m+[m[32m            code = process.wait()[m
[32m+[m[32m            self._events.put(("done", (market_name, code)))[m
[32m+[m[32m        except Exception as exc:[m
[32m+[m[32m            self._terminate_running_process()[m
[32m+[m[32m            self._events.put(("error", (market_name, str(exc))))[m
[32m+[m[32m        finally:[m
[32m+[m[32m            child = locals().get("process")[m
[32m+[m[32m            if child is not None and child.stdout is not None:[m
[32m+[m[32m                child.stdout.close()[m
[32m+[m[32m            with self._process_lock:[m
[32m+[m[32m                if self._process is child:[m
[32m+[m[32m                    self._process = None[m
